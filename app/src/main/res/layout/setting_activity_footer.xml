<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dim_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dim_24dp"
    android:paddingEnd="@dimen/dim_24dp">
    <Button
        android:id="@+id/button_sync_device_settings"
        android:layout_width="match_parent"
        android:text="@string/sync_device_settings"
        style="@style/button_setting_sync"/>
    <Button
        android:id="@+id/button_update_device_clock"
        android:layout_width="match_parent"
        android:text="@string/update_device_clock"
        style="@style/button_setting_sync"/>
</LinearLayout>
