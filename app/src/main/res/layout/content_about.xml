<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_about"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/about_bkg1"
        android:scaleType="centerCrop"
        android:contentDescription="@string/str_hash"
        android:alpha="0.15"/>
    <TextView
        android:textSize="@dimen/fontSize_28sp"
        android:textColor="@color/colorAccent"
        android:id="@+id/about_aap_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_above="@+id/about_aap_vers"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <TextView
        android:textSize="@dimen/fontSize_22sp"
        android:textColor="@color/textColorSecondary"
        android:id="@+id/about_aap_vers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_aap_vers"
        android:layout_above="@+id/about_logo"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/about_logo"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_fha_1"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/str_hash"/>
    <TextView
        android:textSize="@dimen/fontSize_18sp"
        android:textColor="@color/textColorSecondary"
        android:id="@+id/about_aap_copyright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_aap_copyright"
        android:layout_below="@+id/about_logo"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
</RelativeLayout>
