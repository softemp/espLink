<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/dim_24dp"
    android:paddingTop="@dimen/dim_8dp"
    android:paddingRight="@dimen/dim_24dp"
    android:paddingBottom="@dimen/dim_8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/wifi_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/wifi_level"/>
    <TextView
        android:textSize="@dimen/fontSize_18sp"
        android:layout_gravity="center_vertical"
        android:id="@+id/wifi_name"
        android:paddingLeft="@dimen/dim_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
