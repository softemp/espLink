<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_container"
    android:background="@drawable/header_bkg_1"
    android:paddingBottom="@dimen/dim_6dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:scaleType="centerCrop"
    android:layout_alignParentTop="true"
    android:paddingStart="@dimen/dim_12dp"
    android:paddingEnd="@dimen/dim_12dp">
    <ImageView
        android:id="@+id/img_device_icon"
        android:tint="@color/colorRed"
        android:layout_above="@+id/img_device_strength"
        android:contentDescription="@string/str_hash"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ic_connect_device_black_24dp"
        style="@style/imageView_Icon"/>
    <TextView
        android:id="@+id/device_name"
        android:layout_alignTop="@+id/img_device_icon"
        android:layout_toEndOf="@+id/img_device_icon"
        style="@style/text_style_header"/>
    <ImageView
        android:id="@+id/img_device_strength"
        android:tint="@color/colorBlue"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/str_hash"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ic_signal_wifi_0_bar_black_24dp"
        style="@style/imageView_Icon"/>
    <TextView
        android:id="@+id/device_strength"
        android:layout_alignTop="@+id/img_device_strength"
        android:layout_toEndOf="@+id/img_device_strength"
        style="@style/text_style_header"/>
</RelativeLayout>
