<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/MyMaterialTheme.Red"
    android:id="@+id/fragment_3"
    style="@style/nested_scrollview">
    <LinearLayout
        android:id="@+id/fatima_linear_layout_1"
        style="@style/linear_layout_vertical">
        <android.support.v7.widget.CardView
            android:id="@+id/fatima_card_view_1"
            style="@style/card_view.I">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:src="@drawable/card_bkg_3"
                android:scaleType="centerCrop"
                android:tint="@color/md_red_100"
                android:contentDescription="@string/str_hash"/>
            <android.support.percent.PercentRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <android.widget.FrameLayout
                    android:paddingTop="@dimen/dim_12dp"
                    android:paddingBottom="@dimen/dim_12dp"
                    android:layout_width="@dimen/dim_0dp"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/dim_16dp"
                    android:paddingEnd="@dimen/dim_8dp"
                    android:layout_alignParentStart="true"
                    app:layout_widthPercent="50%"
                    app:layout_aspectRatio="100%">
                    <fatima.tech.espnetsmart.ColorArcProgressBar
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/sensors_arcProgess21"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:back_color="@color/md_blue_grey_300"
                        app:back_width="@dimen/dim_8dp"
                        app:front_width="@dimen/dim_8dp"
                        app:is_need_title="true"
                        app:is_need_content="true"
                        app:is_need_unit="true"
                        app:string_title="Battery"
                        app:string_unit="V"
                        app:is_float="true"/>
                </android.widget.FrameLayout>
                <android.widget.FrameLayout
                    android:paddingTop="@dimen/dim_12dp"
                    android:paddingBottom="@dimen/dim_12dp"
                    android:layout_width="@dimen/dim_0dp"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/dim_8dp"
                    android:paddingEnd="@dimen/dim_16dp"
                    android:layout_alignParentEnd="true"
                    app:layout_widthPercent="50%"
                    app:layout_aspectRatio="100%">
                    <fatima.tech.espnetsmart.ColorArcProgressBar
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/sensors_arcProgess22"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:back_color="@color/md_blue_grey_300"
                        app:back_width="@dimen/dim_8dp"
                        app:front_width="@dimen/dim_8dp"
                        app:is_need_title="true"
                        app:is_need_content="true"
                        app:is_need_unit="true"
                        app:string_title="AC Mains"
                        app:string_unit="V"/>
                </android.widget.FrameLayout>
            </android.support.percent.PercentRelativeLayout>
        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:id="@+id/fatima_card_view_2"
            style="@style/card_view.II">
            <RelativeLayout
                android:id="@+id/fatima_relative_layout_2"
                style="@style/relative_layout.III">
                <ImageView
                    android:id="@+id/sensors_imageView11"
                    android:background="@color/md_purple_300"
                    android:src="@drawable/ic_wb_sunny_black_72dp"
                    android:tint="@color/cardBackground"
                    android:contentDescription="@string/str_hash"
                    style="@style/imageview_big_ico"/>
                <TextView
                    android:id="@+id/sensors_textView11"
                    android:text="@string/str_illumination"
                    android:layout_toEndOf="@+id/sensors_imageView11"
                    style="@style/text_style.I.a"/>
                <TextView
                    android:id="@+id/sensors_textView12"
                    android:layout_below="@+id/sensors_textView11"
                    android:layout_toEndOf="@+id/sensors_imageView11"
                    style="@style/text_style.II.a"/>
                <TextView
                    android:id="@+id/sensors_textView13"
                    android:layout_toEndOf="@+id/sensors_imageView11"
                    style="@style/text_style.III.Info.a"/>
            </RelativeLayout>
        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:id="@+id/fatima_card_view_3"
            style="@style/card_view.II">
            <RelativeLayout
                android:id="@+id/fatima_relative_layout_3"
                style="@style/relative_layout.III">
                <ImageView
                    android:id="@+id/sensors_imageView21"
                    android:background="@color/md_cyan_300"
                    android:src="@drawable/ico_humidity"
                    android:tint="@color/cardBackground"
                    android:contentDescription="@string/str_hash"
                    style="@style/imageview_big_ico"/>
                <TextView
                    android:id="@+id/sensors_textView21"
                    android:text="@string/str_humidity"
                    android:layout_toEndOf="@+id/sensors_imageView21"
                    style="@style/text_style.I.a"/>
                <TextView
                    android:id="@+id/sensors_textView22"
                    android:layout_below="@+id/sensors_textView21"
                    android:layout_toEndOf="@+id/sensors_imageView21"
                    style="@style/text_style.II.a"/>
                <TextView
                    android:id="@+id/sensors_textView23"
                    android:layout_toEndOf="@+id/sensors_imageView21"
                    style="@style/text_style.III.Info.a"/>
            </RelativeLayout>
        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:id="@+id/fatima_card_view_4"
            style="@style/card_view.II">
            <RelativeLayout
                android:id="@+id/fatima_relative_layout_4"
                style="@style/relative_layout.III">
                <ImageView
                    android:id="@+id/sensors_imageView31"
                    android:background="@color/md_amber_300"
                    android:src="@drawable/ico_temperature"
                    android:tint="@color/cardBackground"
                    android:contentDescription="@string/str_hash"
                    style="@style/imageview_big_ico"/>
                <TextView
                    android:id="@+id/sensors_textView31"
                    android:text="@string/str_tempRoom"
                    android:layout_toEndOf="@+id/sensors_imageView31"
                    style="@style/text_style.I.a"/>
                <TextView
                    android:id="@+id/sensors_textView32"
                    android:layout_below="@+id/sensors_textView31"
                    android:layout_toEndOf="@+id/sensors_imageView31"
                    style="@style/text_style.II.a"/>
                <TextView
                    android:id="@+id/sensors_textView33"
                    android:layout_toEndOf="@+id/sensors_imageView31"
                    style="@style/text_style.III.Info.a"/>
            </RelativeLayout>
        </android.support.v7.widget.CardView>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
