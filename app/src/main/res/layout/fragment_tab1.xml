<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/MyMaterialTheme.Blue"
    android:id="@+id/fragment_1"
    style="@style/nested_scrollview">
    <LinearLayout
        android:id="@+id/fatima_linear_layout_0"
        style="@style/linear_layout_vertical">
        <android.support.v7.widget.CardView
            android:id="@+id/fatima_card_view_0"
            android:layout_height="328dp"
            style="@style/card_view.I">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:src="@drawable/card_bkg_1"
                android:scaleType="centerCrop"
                android:contentDescription="@string/str_hash"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/fatima_relative_layout_2"
                    style="@style/relative_layout.I">
                    <TextView
                        android:id="@+id/pump_textView20"
                        android:text="@string/str_pump_lev"
                        style="@style/text_style.I"/>
                    <TextView
                        android:id="@+id/pump_textView21"
                        android:layout_below="@+id/pump_textView20"
                        style="@style/text_style.II"/>
                    <TextView
                        android:id="@+id/pump_textView22"
                        style="@style/text_style.III.Info.Tank"/>
                    <TextView
                        android:id="@+id/pump_textView22_inset"
                        android:text="@string/str_remaining_water"
                        android:layout_above="@+id/pump_textView22"
                        android:layout_alignStart="@+id/pump_textView22"
                        style="@style/text_style_timer_inset"/>
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true">
                        <View
                            android:id="@+id/tank_cap"
                            android:background="@drawable/water_tank_round_corner_cap"
                            android:layout_width="30dp"
                            android:layout_height="5dp"
                            android:layout_centerHorizontal="true"/>
                        <cn.fanrunqi.waveprogress.WaveProgressView
                            android:id="@+id/water_level_progress"
                            android:background="@drawable/water_tank_bkg"
                            android:layout_width="90dp"
                            android:layout_height="134dp"
                            android:layout_below="@+id/tank_cap"/>
                        <View
                            android:background="@drawable/water_tank_round_corner_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_alignTop="@+id/water_level_progress"
                            android:layout_alignBottom="@+id/water_level_progress"
                            android:layout_alignStart="@+id/water_level_progress"
                            android:layout_alignEnd="@+id/water_level_progress"/>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/fatima_relative_layout_0"
                    style="@style/relative_layout.I">
                    <TextView
                        android:id="@+id/pump_textView10"
                        android:text="@string/str_switch_1"
                        style="@style/text_style.I"/>
                    <TextView
                        android:id="@+id/pump_textView11"
                        android:layout_below="@+id/pump_textView10"
                        style="@style/text_style.II"/>
                    <TextView
                        android:theme="@style/text_style_timerOn_theme"
                        android:id="@+id/pump_textView12"
                        android:tag="0"
                        style="@style/text_style_timer.TimerON"/>
                    <TextView
                        android:id="@+id/pump_textView12_inset"
                        android:layout_above="@+id/pump_textView12"
                        android:layout_alignStart="@+id/pump_textView12"
                        style="@style/text_style_timer_inset.ON"/>
                    <TextView
                        android:theme="@style/text_style_timerOff_theme"
                        android:id="@+id/pump_textView13"
                        android:tag="0"
                        android:layout_toEndOf="@+id/pump_textView12"
                        style="@style/text_style_timer.TimerOFF"/>
                    <TextView
                        android:id="@+id/pump_textView13_inset"
                        android:layout_above="@+id/pump_textView13"
                        android:layout_alignStart="@+id/pump_textView13"
                        style="@style/text_style_timer_inset.OFF"/>
                    <ToggleButton
                        android:id="@+id/pump_toggleButton10"
                        android:tag="0"
                        style="@style/toggle_button_large"/>
                    <TextView
                        android:id="@+id/pump_textView14"
                        android:layout_alignTop="@+id/pump_toggleButton10"
                        android:layout_alignStart="@+id/pump_toggleButton10"
                        android:translationZ="100dp"
                        style="@style/text_style_timer_btnInset"/>
                    <fatima.tech.espnetsmart.TriToggleButton
                        android:id="@+id/pump_triToggleButton10"
                        android:tag="0"
                        android:layout_below="@+id/pump_toggleButton10"
                        style="@style/tri_toggle_button.II"/>
                </RelativeLayout>
            </LinearLayout>
        </android.support.v7.widget.CardView>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
