<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/MyMaterialTheme.Teal"
    android:id="@+id/fatima_relative_layout_1"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v4.widget.NestedScrollView
        android:layout_gravity="fill_vertical"
        android:id="@+id/logs_nested_scroll_view_1"
        android:paddingTop="@dimen/dim_60dp"
        android:fadingEdgeLength="@dimen/dim_4dp"
        android:requiresFadingEdge="vertical"
        style="@style/nested_scrollview">
        <TextView
            android:id="@+id/logs_textView13"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text=""
            style="@style/text_view_logs_style.content"/>
    </android.support.v4.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/fatima_relative_layout_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/fatima_linear_layout_1"
            style="@style/linear_layout_horizontal_2">
            <EditText
                android:textColor="@color/colorTeal"
                android:id="@+id/logs_editText11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_2dp"
                android:hint="@string/str_edit_text_data_out"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:colorControlActivated="@color/colorTeal"/>
            <ToggleButton
                android:id="@+id/logs_button12"
                style="@style/button_send_data_type"/>
            <Button
                android:id="@+id/logs_button11"
                style="@style/button_send_data_out"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
