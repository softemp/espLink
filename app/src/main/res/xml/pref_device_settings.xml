<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/network_setting_category_title"
        android:key="network_setting">
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/wifi_ssid_title"
            android:key="wifiSSID"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/wifiSSID"
            android:dialogMessage="WiFi SSID that you would like to connect at startup. If connection fail, an access point will be created with same name with a postfix -AP"
            android:inputType="textPersonName"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:maxLength="16"
            android:title="@string/wifi_pass_title"
            android:key="wifiPass"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/wifiPass"
            android:dialogMessage="Password should be at least 8 character or number long"
            android:inputType="textPersonName"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:digits="0123456789."
            android:title="@string/serv_ip_title"
            android:key="ServIP"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/ServIP"
            android:dialogMessage="Please provide IP within the range of your router, if you are connection through router"
            android:inputType="numberDecimal"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/http_port_title"
            android:key="httpPort"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/httpPort"
            android:dialogMessage="We do not recommend to change it but if you want it could be any number"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/sock_port_title"
            android:key="sockPort"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/sockPort"
            android:dialogMessage="We do not recommend to change it but if you want it could be any number"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/mdnsName_title"
            android:key="mdnsName"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/mdnsName"
            android:dialogMessage="MDNS or host name so that user can connect to server without knowing your IP"
            android:inputType="textPersonName"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/water_level_category_title"
        android:key="water_level">
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/water_tank_cap_title"
            android:key="tank_capacity"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="500"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/water_tank_pre_sens_low_title"
            android:key="pressure_sensor_low"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="0"
            android:dialogMessage="Pressure sensor reading for empty tank (0-1023)"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/water_tank_pre_sens_high_title"
            android:key="pressure_sensor_high"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="1023"
            android:dialogMessage="Pressure sensor reading for full tank (0-1023)"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/pump_auto_start_level_title"
            android:key="pump_auto_start_level"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="80"
            android:dialogMessage="Water level (%) below which pump will start automatically (0-99)"
            android:inputType="number"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/power_sensor_category_title"
        android:key="power_sensor">
        <com.afollestad.materialdialogs.prefs.MaterialListPreference
            android:persistent="true"
            android:entries="@array/battery_rating_list_title"
            android:title="@string/battery_rating_title"
            android:key="battery_rating_list"
            android:defaultValue="12"
            android:positiveButtonText="@null"
            android:negativeButtonText="@null"
            android:entryValues="@array/battery_rating_list_values"/>
        <com.afollestad.materialdialogs.prefs.MaterialListPreference
            android:persistent="true"
            android:entries="@array/ac_power_rating_list_title"
            android:title="@string/ac_power_rating_title"
            android:key="ac_power_rating_list"
            android:defaultValue="220"
            android:positiveButtonText="@null"
            android:negativeButtonText="@null"
            android:entryValues="@array/ac_power_rating_list_values"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/light_sensor_category_title"
        android:key="light_sensor">
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/light_low_cutoff_title"
            android:key="light_cutoff"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="10"
            android:dialogMessage="Sunlight sensor reading for lights switch OFF (0-65000)"
            android:inputType="number"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/light_low_cuton_title"
            android:key="light_cuton"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="10"
            android:dialogMessage="Sunlight sensor reading for lights switch ON (0-65000)"
            android:inputType="number"/>
    </PreferenceCategory>
</PreferenceScreen>
