<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/str_theme_category_title"
        android:key="app_theme">
        <com.afollestad.materialdialogs.prefs.MaterialListPreference
            android:persistent="true"
            android:entries="@array/pref_themes_list_titles"
            android:title="@string/str_pref_themes_title"
            android:key="pref_themes"
            android:positiveButtonText="@null"
            android:negativeButtonText="@null"
            android:entryValues="@array/pref_themes_list_values"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/str_network_category_title"
        android:key="water_level">
        <SwitchPreference
            android:persistent="true"
            android:title="@string/pref_wifi_permission_title"
            android:key="wifi_permission_switch"
            android:summary="@string/pref_wifi_permission_summary"
            android:defaultValue="false"/>
        <SwitchPreference
            android:persistent="true"
            android:title="@string/pref_sync_title"
            android:key="sync_freq_switch"
            android:summary="@string/pref_sync_summary"
            android:defaultValue="false"/>
        <com.afollestad.materialdialogs.prefs.MaterialListPreference
            android:persistent="true"
            android:entries="@array/pref_sync_freq_list_titles"
            android:title="@string/pref_sync_freq_title"
            android:key="pref_sync_freq"
            android:dependency="sync_freq_switch"
            android:defaultValue="15"
            android:positiveButtonText="@null"
            android:negativeButtonText="@null"
            android:entryValues="@array/pref_sync_freq_list_values"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/str_switch_description_title"
        android:key="water_level">
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/str_switch_1"
            android:key="switchName1"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/str_switch_1"
            android:dialogMessage="Choose short description for Switch 1"
            android:inputType="textPersonName"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/str_switch_2"
            android:key="switchName2"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/str_switch_2"
            android:dialogMessage="Choose short description for Switch 2"
            android:inputType="textPersonName"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:persistent="true"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:title="@string/str_switch_3"
            android:key="switchName3"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/str_switch_3"
            android:dialogMessage="Choose short description for Switch 3"
            android:inputType="textPersonName"/>
        <com.afollestad.materialdialogs.prefs.MaterialEditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:title="@string/str_switch_4"
            android:key="switchName4"
            android:summary="@string/str_not_set_yet"
            android:defaultValue="@string/str_switch_4"
            android:dialogMessage="Choose short description for Switch 4"
            android:inputType="textPersonName"/>
    </PreferenceCategory>
</PreferenceScreen>
